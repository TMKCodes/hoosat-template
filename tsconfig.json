{
  // Specify the compiler options
  "compilerOptions": {
    // Set the output directory for plain tsc builds
    "outDir": "./build-ts",
    // Root of the source files (required by TypeScript 6 when emitting)
    "rootDir": "./src",
    // Use ES modules, webpack bundles them
    "module": "ESNext",
    // Set the ECMAScript target version
    "target": "ES2023",
    // Use the automatic JSX runtime (React 17+), importing React in every file is not required
    "jsx": "react-jsx",
    // Specify the library files to include
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    // Type packages to include (TypeScript 6 no longer includes every @types package by default)
    "types": ["node", "jest"],
    // Enable source maps for easier debugging
    "sourceMap": true,
    // Allow importing CommonJS modules with default imports
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // Resolve modules the same way webpack does
    "moduleResolution": "bundler",
    // Enable importing JSON files as modules
    "resolveJsonModule": true,
    // Generate declaration files
    "declaration": true,
    // [Optional] Enable emitting declaration map files
    "declarationMap": true,
    // Enable all strict type checks
    "strict": true,
    // swc compiles one file at a time, so reject code that needs the whole program to compile
    "isolatedModules": true,
    // Require all code paths in a function to return a value
    "noImplicitReturns": true,
    // [Optional] Enable decorators
    "experimentalDecorators": true,
    // [Optional] Enable no unused variables check
    "noUnusedLocals": false,
    // [Optional] Enable no unused parameters check
    "noUnusedParameters": true,
    // Skip type checking of declaration files in node_modules
    "skipLibCheck": true,
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "typedocOptions": {
    "entryPoints": ["./src"],
    "entryPointStrategy": "expand",
    "out": "public/docs"
  },
  // Specify the files and directories to include in compilation
  "include": ["src/**/*.tsx", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
