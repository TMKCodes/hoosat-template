{
  "type": "module",
  "name": "hoosat-create",
  "version": "1.0.0",
  "description": "Hoosat Create is React SSR & CSR Stack made by TMKCodes",
  "author": "",
  "license": "MIT License",
  "main": "index.js",
  "bugs": {
    "url": "https://github.com/TMKCodes/hoosat-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TMKCodes/hoosat-template"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "rsync": "rsync -rPz --delete ./build ./package.json YOURSERVER:~FOLDER",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "clean:build-dev": "node build-tools/fs.ts rm build-dev",
    "clean:build-ts": "node build-tools/fs.ts rm build-ts",
    "clean:build": "node build-tools/fs.ts rm build",
    "clean": "node build-tools/fs.ts rm build-ts build-dev build",
    "dev:compress:assets:br": "node build-tools/compress-files.ts build-dev/public/ br",
    "dev:compress:assets:deflate": "node build-tools/compress-files.ts build-dev/public/ deflate",
    "dev:compress:assets:gzip": "node build-tools/compress-files.ts build-dev/public/ gzip",
    "dev:compress:assets": "npm-run-all dev:compress:assets:br dev:compress:assets:deflate dev:compress:assets:gzip",
    "dev:create:build:directories": "node build-tools/fs.ts mkdir build-dev/public/uploads",
    "dev:create:service-worker:urls": "node public/service-worker-urls.js build-dev/public",
    "dev:move:assets": "node build-tools/fs.ts cp public build-dev/public",
    "dev:move:css": "node build-tools/extract-css.ts src/client build-dev/public/styles.css",
    "dev:build:client": "webpack --config webpack.client.config.js --mode=development",
    "dev:build:server": "webpack --config webpack.server.config.js --mode=development",
    "dev:prebuild": "npm-run-all dev:create:build:directories dev:move:assets dev:move:css dev:create:service-worker:urls",
    "dev:build": "npm-run-all dev:prebuild dev:build:client dev:build:server dev:compress:assets",
    "dev:start": "nodemon --watch build-dev/server.js --delay 1 build-dev/server.js development",
    "dev:watch": "nodemon --on-change-only --watch src --watch public --ext ts,tsx,js,jsx,css,json --exec \"npm run dev:build\"",
    "dev": "cross-env NODE_ENV=development npm-run-all clean:build-ts clean:build-dev dev:build --parallel dev:watch dev:start",
    "compress:assets:br": "node build-tools/compress-files.ts build/public/ br",
    "compress:assets:deflate": "node build-tools/compress-files.ts build/public/ deflate",
    "compress:assets:gzip": "node build-tools/compress-files.ts build/public/ gzip",
    "compress:assets": "npm-run-all compress:assets:br compress:assets:deflate compress:assets:gzip",
    "create:build:directories": "node build-tools/fs.ts mkdir build/public/uploads",
    "create:service-worker:urls": "node public/service-worker-urls.js build/public",
    "move:assets": "node build-tools/fs.ts cp public build/public",
    "move:css": "node build-tools/extract-css.ts src/client build/public/styles.css",
    "build:client": "webpack --config webpack.client.config.js --mode=production",
    "build:server": "webpack --config webpack.server.config.js --mode=production",
    "build:prepare": "npm-run-all clean:build-ts clean:build create:build:directories move:assets move:css create:service-worker:urls",
    "build": "cross-env NODE_ENV=production npm-run-all build:prepare build:client build:server compress:assets",
    "deploy": "npm-run-all build rsync clean:build clean:build-ts",
    "production:start": "node build/server.js",
    "start": "npm run production:start"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "formidable": "^3.5.4",
    "i18next": "^27.2.1",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-fs-backend": "^2.7.0",
    "i18next-http-backend": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/formidable": "^3.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "jest": "^30.5.2",
    "node-loader": "^2.1.0",
    "nodemon": "^3.1.14",
    "npm-run-all2": "^9.0.4",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "keywords": []
}
